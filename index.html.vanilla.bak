       MODALS & FLOATING ACTIONS
       ======================================================================== -->
  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-modal="true" aria-label="Portfolio Image Preview">
    <div class="lightbox-content">
      <button class="lightbox-close" aria-label="Close image preview">&times;</button>
      <div class="lightbox-img-wrapper">
        <img id="lightbox-img" src="" alt="Portfolio preview" />
      </div>
      <div class="lightbox-caption">
        <h4 id="lightbox-title"></h4>
        <p id="lightbox-subtitle"></p>
      </div>
    </div>
    <button class="lightbox-nav lightbox-prev" aria-label="Previous image">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="lightbox-nav lightbox-next" aria-label="Next image">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>

  <!-- Booking Appointment Modal -->
  <div id="booking-modal" class="booking-modal" role="dialog" aria-modal="true" aria-label="Book Bridal Consultation">
    <div class="booking-modal-box">
      <button class="modal-close-btn" aria-label="Close booking modal">&times;</button>
      <div class="section-header" style="margin-bottom: 2rem;">
        <span class="eyebrow">Priority Reservation</span>
        <h2 class="section-title" style="font-size: 2.25rem;">Book Your Appointment</h2>
        <p class="section-subtitle">Reserve Jyoti Khatri for your special date.</p>
        <div class="heading-gold-line">
          <span></span>
        </div>
      </div>

      <form id="modal-booking-form">
        <div class="form-row">
          <div class="form-group">
            <label for="modal-name">Bride's Name *</label>
            <input type="text" id="modal-name" name="name" placeholder="Full name" required />
          </div>
          <div class="form-group">
            <label for="modal-phone">Phone / WhatsApp *</label>
            <input type="tel" id="modal-phone" name="phone" placeholder="+91 98765 00000" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="modal-email">Email Address *</label>
            <input type="email" id="modal-email" name="email" placeholder="yourname@gmail.com" required />
          </div>
          <div class="form-group">
            <label for="modal-date">Event Date *</label>
            <input type="date" id="modal-date" name="date" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="modal-service">Select Service *</label>
            <select id="modal-service" name="service" required>
              <option value="Bridal Makeup">Bridal Makeup</option>
              <option value="Engagement Makeup">Engagement Makeup</option>
              <option value="Reception Makeup">Reception Makeup</option>
              <option value="HD Makeup">HD Makeup</option>
              <option value="Airbrush Makeup">Airbrush Makeup</option>
              <option value="Party & Occasion Makeup">Party &amp; Occasion Makeup</option>
            </select>
          </div>
          <div class="form-group">
            <label for="modal-city">City / Destination *</label>
            <input type="text" id="modal-city" name="city" placeholder="e.g. Mumbai / Jaipur" required />
          </div>
        </div>

        <div class="form-group">
          <label for="modal-notes">Additional Notes</label>
          <textarea id="modal-notes" name="notes" placeholder="Number of functions, timings, or styling preferences..."></textarea>
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%;">Submit Booking Request</button>
      </form>
    </div>
  </div>

