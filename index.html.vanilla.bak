<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  
  <!-- SEO & Brand Metadata -->
  <title>Makeup by Jyoti Khatri | Luxury Indian Bridal & Beauty Makeup Artist</title>
  <meta name="description" content="Makeup by Jyoti Khatri offers luxury bridal, engagement, reception, and occasion makeovers. Enhancing your authentic beauty with signature high-definition and airbrush artistry." />
  <meta name="keywords" content="bridal makeup artist, indian bridal makeup, luxury bridal makeup, hd makeup, airbrush makeup, wedding makeover, Jyoti Khatri" />
  <meta name="author" content="Makeup by Jyoti Khatri" />
  
  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Makeup by Jyoti Khatri | Luxury Bridal & Beauty Artistry" />
  <meta property="og:description" content="Enhancing Your Beauty, Creating Your Signature Look. Luxury bridal & occasion makeup by Jyoti Khatri." />
  <meta property="og:image" content="https://images.unsplash.com/photo-jyotikhatri6.png?q=80&w=1200&auto=format&fit=crop" />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Marcellus&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>

  <!-- ========================================================================
       1. HEADER / STICKY NAVIGATION
       ======================================================================== -->
  <header class="header">
    <div class="container nav-container">
      <!-- Logo area (supports text or future image logo upload) -->
      <a href="#hero" class="logo" aria-label="Makeup by Jyoti Khatri Home">
        <div class="logo-badge-slot">
          <span class="logo-main">Makeup by Jyoti Khatri</span>
        </div>
        <span class="logo-sub">Bridal &bull; Beauty &bull; Artistry</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="nav-links" aria-label="Main Navigation">
        <a href="#hero" class="nav-link active">Home</a>
        <a href="#about" class="nav-link">About</a>
        <a href="#services" class="nav-link">Services</a>
        <a href="#bridal-experience" class="nav-link">Bridal</a>
        <a href="#portfolio" class="nav-link">Portfolio</a>
        <a href="#reviews" class="nav-link">Reviews</a>
        <a href="#contact" class="nav-link">Contact</a>
      </nav>

      <!-- Header Actions (Social & Booking) -->
      <div class="header-actions">
        <a href="https://instagram.com/makeupbyjyotikhatri" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Follow Jyoti on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://wa.me/919876543210?text=Hello%20Jyoti%2C%20I%20would%20like%20to%20enquire%20about%20bridal%20makeup." target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Chat with Jyoti on WhatsApp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        </a>
        <button class="btn btn-primary btn-sm" data-open-booking>Book Now</button>
        
        <!-- Mobile Hamburger Toggle Button -->
        <button class="mobile-toggle" aria-label="Toggle mobile menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-nav-backdrop"></div>
  <aside class="mobile-nav" aria-label="Mobile Navigation">
    <button class="mobile-nav-close" aria-label="Close menu">&times;</button>
    <div class="mobile-nav-links">
      <a href="#hero">Home</a>
      <a href="#about">Meet Jyoti</a>
      <a href="#services">Services</a>
      <a href="#bridal-experience">The Bridal Experience</a>
      <a href="#portfolio">Portfolio Gallery</a>
      <a href="#reviews">Bride Reviews</a>
      <a href="#contact">Contact & Booking</a>
    </div>
    <div style="margin-top: auto; padding-top: 2rem;">
      <button class="btn btn-gold btn-sm" style="width: 100%;" data-open-booking>Book Appointment</button>
    </div>
  </aside>

  <main>
    <!-- ======================================================================
         2. HERO SECTION
         ====================================================================== -->
    <section id="hero" class="hero-section">
      <div class="hero-bg-overlay"></div>
      
      <div class="container">
        <div class="hero-grid">
          <!-- Left Column Content -->
          <div class="hero-content">
            <span class="eyebrow">Bridal &amp; Beauty Makeup Artist</span>
            <h1 class="hero-title">Makeup by Jyoti Khatri</h1>
            <p class="hero-statement">
              &ldquo;Enhancing Your Beauty,<br />
              Creating Your Signature Look.&rdquo;
            </p>
            <p class="hero-description">
              Luxury bridal, engagement and occasion makeup crafted to make you feel confident, radiant and completely yourself.
            </p>
            <div class="hero-buttons">
              <button class="btn btn-primary" data-open-booking>Book Your Appointment</button>
              <a href="#portfolio" class="btn btn-outline">View Portfolio</a>
            </div>
          </div>

          <!-- Right Column Bridal Portrait Visual & Rotating Badge -->
          <div class="hero-visual">
            <div class="hero-arch-accent"></div>
            
            <div class="hero-image-frame">
              <img 
                src="https://images.unsplash.com/photo-jyotikhatri6.png?q=80&w=1200&auto=format&fit=crop" 
                alt="Luxury Indian Bridal Makeup Portrait by Jyoti Khatri" 
                loading="eager"
              />
            </div>

            <!-- Rotating Circular Text Badge -->
            <div class="circular-badge" aria-hidden="true">
              <svg class="circular-text-svg" viewBox="0 0 140 140">
                <path id="badge-circle-path" d="M 70, 70 m -50, 0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0" fill="none" />
                <text font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="600" fill="#E8D39E" letter-spacing="2.2">
                  <textPath href="#badge-circle-path" startOffset="0%">
                    MAKEUP &bull; BEAUTY &bull; BRIDAL &bull; JYOTI KHATRI &bull;
                  </textPath>
                </text>
              </svg>
              <div class="circular-badge-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              </div>
            </div>

            <!-- Subtle floating decorative elements -->
            <div class="floating-accent floating-accent-1">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="#C5A059" opacity="0.7"><path d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1-6.3-4.6-6.3 4.6 2.3-7.1-6-4.5h7.6z"/></svg>
            </div>
            <div class="floating-accent floating-accent-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#D8A499" opacity="0.6"><circle cx="12" cy="12" r="8"/></svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         3. TRUST / STATS SECTION
         ====================================================================== -->
    <section class="stats-section" aria-label="Key Milestones and Statistics">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-number">500+</div>
            <div class="stat-label">Happy Brides</div>
            <div class="stat-subtext">Personalized Wedding Looks</div>
            <span class="placeholder-tag">(Placeholder)</span>
          </div>
          <div class="stat-item">
            <div class="stat-number">7+</div>
            <div class="stat-label">Years of Experience</div>
            <div class="stat-subtext">Mastering Bridal Artistry</div>
            <span class="placeholder-tag">(Placeholder)</span>
          </div>
          <div class="stat-item">
            <div class="stat-number">1000+</div>
            <div class="stat-label">Makeovers</div>
            <div class="stat-subtext">Celebrations &amp; Editorial</div>
            <span class="placeholder-tag">(Placeholder)</span>
          </div>
          <div class="stat-item">
            <div class="stat-number">100%</div>
            <div class="stat-label">Personalized Looks</div>
            <div class="stat-subtext">Tailored to Your Features</div>
            <span class="placeholder-tag">(Placeholder)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         4. ABOUT SECTION ("Meet Jyoti Khatri")
         ====================================================================== -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="about-grid">
          <!-- Left Column Portrait of Jyoti -->
          <div class="about-visual">
            <div class="about-offset-border"></div>
            <div class="about-image-wrapper">
              <img 
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=1000&auto=format&fit=crop" 
                alt="Jyoti Khatri - Luxury Bridal Makeup Artist" 
                loading="lazy"
              />
            </div>
          </div>

          <!-- Right Column Editorial Philosophy & Bio -->
          <div class="about-content">
            <span class="eyebrow">Artistry &amp; Philosophy</span>
            <h2 class="section-title">Meet Jyoti Khatri</h2>
            <div class="heading-gold-line" style="justify-content: flex-start; margin-bottom: 1.5rem;">
              <span></span>
            </div>
            
            <p class="about-quote">
              &ldquo;Makeup is not about changing who you are. It is about enhancing the features that make you uniquely beautiful.&rdquo;
            </p>

            <p class="about-text">
              With a background enriched by seven years of styling brides across India and international destination weddings, Jyoti Khatri approaches each face as a unique canvas. Her style is defined by luminous skin, effortless harmony, and an intuitive understanding of traditional Indian heritage balanced with contemporary aesthetics.
            </p>

            <p class="about-text">
              Whether you envision a regal royal red lehenga look, a soft pastel day-wedding aesthetic, or a high-fashion reception avatar, Jyoti's personalized methodology ensures your natural beauty shines without compromise.
            </p>

            <div class="about-footer">
              <button class="btn btn-outline" data-open-booking>More About Jyoti</button>
              <div class="signature-text">With love, Jyoti</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         5. SIGNATURE SERVICES SECTION
         ====================================================================== -->
    <section id="services" class="services-section">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Bespoke Offerings</span>
          <h2 class="section-title">Signature Makeup Services</h2>
          <p class="section-subtitle">Looks thoughtfully created for every celebration.</p>
          <div class="heading-gold-line">
            <span></span>
          </div>
        </div>

        <div class="services-grid">
          <!-- Service 1: Bridal Makeup -->
          <article class="service-card">
            <div class="service-image-box">
              <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=1000&auto=format&fit=crop" alt="Bridal Makeup by Jyoti Khatri" loading="lazy" />
              <span class="service-badge">Signature</span>
            </div>
            <div class="service-content">
              <h3 class="service-title">Bridal Makeup</h3>
              <p class="service-tagline">&ldquo;Your wedding look, thoughtfully designed around you.&rdquo;</p>
              <p class="service-desc">Complete bridal transformation including skin preparation, bespoke waterproof HD/Airbrush base, intricate dupatta setting, jewelry assistance, and all-day longevity.</p>
              <div class="service-card-footer">
                <a href="#contact" class="explore-link" data-open-booking data-service="Bridal Makeup">
                  <span>Explore</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Service 2: Engagement Makeup -->
          <article class="service-card">
            <div class="service-image-box">
              <img src="https://images.unsplash.com/photo-1546804784-896d0dca3805?q=80&w=1000&auto=format&fit=crop" alt="Engagement Makeup by Jyoti Khatri" loading="lazy" />
              <span class="service-badge">Romantic</span>
            </div>
            <div class="service-content">
              <h3 class="service-title">Engagement Makeup</h3>
              <p class="service-tagline">&ldquo;Soft, radiant and effortlessly elegant.&rdquo;</p>
              <p class="service-desc">Delicate pastel palettes, soft-focus contouring, and luminous dewy textures that complement modern designer ring-ceremony lehengas and gowns.</p>
              <div class="service-card-footer">
                <a href="#contact" class="explore-link" data-open-booking data-service="Engagement Makeup">
                  <span>Explore</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Service 3: Reception Makeup -->
          <article class="service-card">
            <div class="service-image-box">
              <img src="https://images.unsplash.com/photo-1566737236500-c8ac43014a67?q=80&w=1000&auto=format&fit=crop" alt="Reception Makeup by Jyoti Khatri" loading="lazy" />
              <span class="service-badge">High Glam</span>
            </div>
            <div class="service-content">
              <h3 class="service-title">Reception Makeup</h3>
              <p class="service-tagline">&ldquo;Glamorous, sophisticated and camera-ready.&rdquo;</p>
              <p class="service-desc">High-impact evening glamour featuring sculpted profiles, dramatic or shimmering eye artistry, and customized lip shades crafted for grand stage appearances.</p>
              <div class="service-card-footer">
                <a href="#contact" class="explore-link" data-open-booking data-service="Reception Makeup">
                  <span>Explore</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Service 4: Party & Occasion Makeup -->
          <article class="service-card">
            <div class="service-image-box">
              <img src="https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?q=80&w=1000&auto=format&fit=crop" alt="Party and Occasion Makeup" loading="lazy" />
              <span class="service-badge">Celebration</span>
            </div>
            <div class="service-content">
              <h3 class="service-title">Party &amp; Occasion Makeup</h3>
              <p class="service-tagline">&ldquo;Beautiful looks for every special celebration.&rdquo;</p>
              <p class="service-desc">Elevated beauty styling for sangeet nights, cocktail parties, bridesmaids, and sisters of the bride who desire refined, comfortable all-night perfection.</p>
              <div class="service-card-footer">
                <a href="#contact" class="explore-link" data-open-booking data-service="Party & Occasion Makeup">
                  <span>Explore</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Service 5: HD Makeup -->
          <article class="service-card">
            <div class="service-image-box">
              <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=1000&auto=format&fit=crop" alt="HD Makeup by Jyoti Khatri" loading="lazy" />
              <span class="service-badge">Camera Ready</span>
            </div>
            <div class="service-content">
              <h3 class="service-title">HD Makeup</h3>
              <p class="service-tagline">&ldquo;Flawless finish designed for photography and long celebrations.&rdquo;</p>
              <p class="service-desc">High-definition micro-fine formulations that reflect light naturally, ensuring crystal clarity in close-up 4K cinematography with zero heavy feel.</p>
              <div class="service-card-footer">
                <a href="#contact" class="explore-link" data-open-booking data-service="HD Makeup">
                  <span>Explore</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Service 6: Airbrush Makeup -->
          <article class="service-card">
            <div class="service-image-box">
              <img src="https://images.unsplash.com/photo-1512496015851-a90fb38ba796?q=80&w=1000&auto=format&fit=crop" alt="Airbrush Makeup by Jyoti Khatri" loading="lazy" />
              <span class="service-badge">Waterproof</span>
            </div>
            <div class="service-content">
              <h3 class="service-title">Airbrush Makeup</h3>
              <p class="service-tagline">&ldquo;Lightweight, smooth and long-lasting perfection.&rdquo;</p>
              <p class="service-desc">Micro-fine precision air mist application creating a velvety, poreless veil. Resistant to tears, humid weather, and friction for up to 18 hours.</p>
              <div class="service-card-footer">
                <a href="#contact" class="explore-link" data-open-booking data-service="Airbrush Makeup">
                  <span>Explore</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         6. BRIDAL EXPERIENCE SECTION
         ====================================================================== -->
    <section id="bridal-experience" class="bridal-experience-section">
      <div class="bridal-bg-art">
        <img src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=1200&auto=format&fit=crop" alt="Bridal Experience Artistry" loading="lazy" />
      </div>

      <div class="container">
        <div class="bridal-experience-grid">
          <!-- Left Column Content & Stages -->
          <div class="bridal-experience-header">
            <span class="eyebrow" style="color: var(--gold-light);">The Bridal Journey</span>
            <h2 class="section-title">Your Bridal Look,<br />Your Story.</h2>
            <p>
              From the first consultation to the final touch, every detail is thoughtfully planned to create a bridal look that feels unmistakably yours.
            </p>

            <div class="stages-list">
              <!-- Stage 01 -->
              <div class="stage-item">
                <div class="stage-number">01</div>
                <div class="stage-content">
                  <h4>Consultation</h4>
                  <div class="stage-subtitle">Vision, Outfits &amp; Skin Prep</div>
                  <p>In-depth dialogue evaluating your wedding aesthetics, bridal attire color palettes, jewelry pieces, and bespoke pre-wedding skincare guidance.</p>
                </div>
              </div>

              <!-- Stage 02 -->
              <div class="stage-item">
                <div class="stage-number">02</div>
                <div class="stage-content">
                  <h4>Personalized Look</h4>
                  <div class="stage-subtitle">Custom Moodboard &amp; Harmony</div>
                  <p>Curating the ideal balance between your dupatta draping, floral hair ornamentation, lip undertone, and contouring for your facial structure.</p>
                </div>
              </div>

              <!-- Stage 03 -->
              <div class="stage-item">
                <div class="stage-number">03</div>
                <div class="stage-content">
                  <h4>The Final Transformation</h4>
                  <div class="stage-subtitle">Calm, Punctual Luxury Execution</div>
                  <p>On your wedding day, Jyoti provides a relaxed, luxurious dressing suite experience using only the finest world-class products that endure all rituals.</p>
                </div>
              </div>
            </div>

            <button class="btn btn-gold" data-open-booking data-service="Bridal Makeup">Plan My Bridal Look</button>
          </div>

          <!-- Right Column Bridal Visual Card -->
          <div class="bridal-visual-card">
            <img src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=1200&auto=format&fit=crop" alt="Indian Bride Getting Ready by Jyoti Khatri" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         7. PORTFOLIO / GALLERY SECTION
         ====================================================================== -->
    <section id="portfolio" class="gallery-section">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Visual Portfolio</span>
          <h2 class="section-title">Beauty in Every Detail</h2>
          <p class="section-subtitle">A glimpse into our bridal and beauty transformations.</p>
          <div class="heading-gold-line">
            <span></span>
          </div>
        </div>

        <!-- Filter Tabs -->
        <div class="gallery-filters" role="tablist">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="bridal">Bridal</button>
          <button class="filter-btn" data-filter="engagement">Engagement</button>
          <button class="filter-btn" data-filter="reception">Reception</button>
          <button class="filter-btn" data-filter="party">Party</button>
          <button class="filter-btn" data-filter="hair">Hair</button>
        </div>

        <!-- Masonry Grid -->
        <div class="gallery-grid" id="gallery-grid">
          <!-- Item 1: Bridal -->
          <div class="gallery-item portrait" data-category="bridal">
            <img src="https://images.unsplash.com/photo-jyotikhatri6.png?q=80&w=1200&auto=format&fit=crop" alt="Royal Crimson Heritage Bride" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category-tag">Bridal</span>
              <h4 class="gallery-title">Royal Crimson Heritage Bride</h4>
              <p class="gallery-subtitle">Traditional North Indian Bridal Styling</p>
              <div class="gallery-zoom-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </div>
            </div>
          </div>

          <!-- Item 2: Engagement -->
          <div class="gallery-item portrait" data-category="engagement">
            <img src="https://images.unsplash.com/photo-1546804784-896d0dca3805?q=80&w=1200&auto=format&fit=crop" alt="Pastel Dewy Engagement" loading="lazy" />
            <div class="gallery-overlay">
              <span class="gallery-category-tag">Engagement</span>
              <h4 class="gallery-title">Pastel Dewy Engagement</h4>
